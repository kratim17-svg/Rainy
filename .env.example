# Rainy runs entirely on-device and needs none of this to work.
#
# Set this only when a push server exists. It is the VAPID *public* key of
# that server; the private key stays on the server and is never committed.
# With it set, subscribeToPush() returns a subscription to hand over, and
# reminders can arrive with the app closed.
#
# VITE_VAPID_PUBLIC_KEY=
